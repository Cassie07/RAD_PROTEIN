                "citation": [
                    {
                        "title": "Crystal Structures of Two H-2Db/Glycopeptide Complexes Suggest a Molecular Basis for Ctl Cross-Reactivity",
                        "pdbx_database_id_PubMed": 10023771,
                        "pdbx_database_id_DOI": "10.1016/S1074-7613(00)80007-2",
                        "rcsb_is_primary": "Y"
