            {
                "rcsb_id": "4DWX",
                "struct": {
                    "title": "Crystal Structure of a Family GH-19 Chitinase from rye seeds"
                },
                "struct_keywords": {
                    "pdbx_keywords": "HYDROLASE",
                    "text": "Chitinase, Hydrolase, Carbohydrate"
                },
                "exptl": [
                    {
                        "method": "X-RAY DIFFRACTION"
                    }
                ],
                "citation": [
                    {
                        "title": "Crystal structure and chitin oligosaccharide-binding mode of a 'loopful' family GH19 chitinase from rye, Secale cereale, seeds",
                        "pdbx_database_id_PubMed": 22831795,
                        "pdbx_database_id_DOI": "10.1111/j.1742-4658.2012.08723.x",
                        "rcsb_is_primary": "Y"
                    }
                ],
                "pubmed": {
                    "rcsb_pubmed_container_identifiers": {
                        "pubmed_id": 22831795
                    },
                    "rcsb_pubmed_mesh_descriptors": [
                        "Amino Acid Sequence",
                        "Binding Sites",
                        "Catalysis",
                        "Catalytic Domain",
                        "Chitin",
                        "Chitinases",
                        "Chromatography, High Pressure Liquid",
                        "Crystallography, X-Ray",
                        "Hydrolysis",
                        "Models, Molecular",
                        "Molecular Sequence Data",
                        "Mutagenesis, Site-Directed",
                        "Mutation",
                        "Nuclear Magnetic Resonance, Biomolecular",
                        "Protein Binding",
                        "Protein Structure, Tertiary",
                        "Secale",
                        "Seeds",
                        "Sequence Homology, Amino Acid",
                        "Substrate Specificity"
                    ],
                    "rcsb_pubmed_abstract_text": "The substrate-binding mode of a 26-kDa GH19 chitinase from rye, Secale cereale, seeds (RSC-c) was investigated by crystallography, site-directed mutagenesis and NMR spectroscopy. The crystal structure of RSC-c in a complex with an N-acetylglucosamine tetramer, (GlcNAc)(4) , was successfully solved, and revealed the binding mode of the tetramer to be an aglycon-binding site, subsites +1, +2, +3, and +4. These are the first crystallographic data showing the oligosaccharide-binding mode of a family GH19 chitinase. From HPLC analysis of the enzymatic reaction products, mutation of Trp72 to alanine was found to affect the product distribution obtained from the substrate, p-nitrophenyl penta-N-acetyl-\u03b2-chitopentaoside. Mutational experiments confirmed the crystallographic finding that the Trp72 side chain interacts with the +4 moiety of the bound substrate. To further confirm the crystallographic data, binding experiments were also conducted in solution using NMR spectroscopy. Several signals in the (1) H-(15) N HSQC spectrum of the stable isotope-labeled RSC-c were affected upon addition of (GlcNAc)(4) . Signal assignments revealed that most signals responsive to the addition of (GlcNAc)(4) are derived from amino acids located at the surface of the aglycon-binding site. The binding mode deduced from NMR binding experiments in solution was consistent with that from the crystal structure.",
                    "rcsb_pubmed_doi": "10.1111/j.1742-4658.2012.08723.x",
                    "rcsb_pubmed_central_id": null
                },
                "polymer_entities": [
                    {
                        "rcsb_entity_source_organism": [
                            {
                                "scientific_name": "Secale cereale",
                                "ncbi_scientific_name": "Secale cereale"
                            }
                        ],
                        "rcsb_polymer_entity": {
                            "rcsb_macromolecular_names_combined": [
                                {
                                    "name": "Basic endochitinase C"
