                "citation": [
                    {
                        "title": "CryoEM structure of a prokaryotic cyclic nucleotide-gated ion channel.",
                        "pdbx_database_id_PubMed": 28396445,
                        "pdbx_database_id_DOI": "10.1073/pnas.1700248114",
